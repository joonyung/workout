<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.joonyung.workout</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PATH__</string>
    <string>__APP_ROOT__/current/scripts/dev-server.mjs</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOST</key>
    <string>127.0.0.1</string>
    <key>PORT</key>
    <string>5002</string>
    <key>WORKOUT_STATIC_ROOT</key>
    <string>__APP_ROOT__/current/dist</string>
    <key>WORKOUT_DATA_DIR</key>
    <string>__APP_ROOT__/state/data</string>
    <key>WORKOUT_INBODY_DIR</key>
    <string>__APP_ROOT__/state/inbody</string>
    <key>REQUIRE_ORIGIN</key>
    <string>true</string>
    <key>REQUIRE_CF_ACCESS</key>
    <string>true</string>
    <key>ALLOWED_ORIGINS</key>
    <string>https://workout.joonyung.work</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>__APP_ROOT__/logs/server.log</string>
  <key>StandardErrorPath</key>
  <string>__APP_ROOT__/logs/server-error.log</string>
</dict>
</plist>
